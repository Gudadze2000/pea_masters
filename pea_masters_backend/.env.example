# Copy to .env and fill in. Never commit .env.

# Google Cloud Console -> Google Auth Platform -> Clients (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Address the browser uses for the app. In development that is the Vite dev server,
# which proxies /api to this backend. The Google redirect URI is PUBLIC_URL + /api/v1/auth/google/callback
PUBLIC_URL=http://localhost:5173

# Signs the short-lived cookie that holds Google sign-in state.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Matches docker-compose.yml. Use 127.0.0.1, not localhost: on Windows, localhost tries IPv6 first and stalls
DATABASE_URL=postgresql+psycopg://pea:pea@127.0.0.1:5434/pea

# true in production (HTTPS only)
SECURE_COOKIES=false

# Where uploaded files (photos, documents) are kept
STORAGE_DIR=storage
