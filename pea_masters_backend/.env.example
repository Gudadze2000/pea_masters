# Copy to .env and fill in. Never commit .env.

# Google Cloud Console -> Google Auth Platform -> Clients (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Address the browser uses for the app. In development that is the Vite dev server,
# which proxies /api to this backend. The Google redirect URI is PUBLIC_URL + /api/v1/auth/google/callback
PUBLIC_URL=http://localhost:5173

# Signs the short-lived cookie that holds Google sign-in state.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Matches docker-compose.yml. Use 127.0.0.1, not localhost: on Windows, localhost tries IPv6 first and stalls
DATABASE_URL=postgresql+psycopg://pea:pea@127.0.0.1:5434/pea

# true in production (HTTPS only). With an https PUBLIC_URL, PEA refuses to start while this is false, SESSION_SECRET is
# short or DATABASE_URL uses the development password.
SECURE_COOKIES=false

# Interactive API docs at /api/docs: on in development, off in production unless set to true
# API_DOCS=

# Where uploaded files (photos, documents) are kept
STORAGE_DIR=storage

# Clarivate Web of Science Starter API key (from the research office). Leave empty to switch article checks off.
CLARIVATE_API_KEY=

# Optional: a project/team contact address Crossref may use if PEA misbehaves (gives faster responses). Not personal.
CROSSREF_MAILTO=

# ORCID Public API (orcid.org -> your name -> Developer tools). Leave empty to switch ORCID off.
# ORCID only accepts https redirect URIs: in development register a forwarding page (see README) and put it here.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_BASE_URL=https://sandbox.orcid.org
ORCID_REDIRECT_URI=
