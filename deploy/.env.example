# Copy to deploy/.env on the server and fill in. Never commit .env. (chmod 600 .env)

# The address people open
PEA_DOMAIN=pea.iliauni.edu.ge

# Database password. Letters and digits only (it goes inside a URL). Generate: openssl rand -hex 32
DB_PASSWORD=

# Signs the short-lived Google sign-in cookie. Generate: openssl rand -base64 48
SESSION_SECRET=

# Google Cloud Console -> Google Auth Platform -> Clients. Add the redirect URI
# https://<PEA_DOMAIN>/api/v1/auth/google/callback to the client first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clarivate Web of Science Starter API key. Empty: article checks are off.
CLARIVATE_API_KEY=

# Optional project contact address for Crossref (never a person's own)
CROSSREF_MAILTO=

# ORCID Public API. Register https://<PEA_DOMAIN>/api/v1/orcid/callback as a redirect URI and leave
# ORCID_REDIRECT_URI empty. https://sandbox.orcid.org while testing, https://orcid.org for real use.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_BASE_URL=https://sandbox.orcid.org
ORCID_REDIRECT_URI=
