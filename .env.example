# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# Account creation: sign-up is closed. Only the emails listed here can create an
# account (comma-separated). Add a colleague's email before they register.
AUTH_SIGNUP=invited
AUTH_BOOTSTRAP_ADMINS=admin@test.local